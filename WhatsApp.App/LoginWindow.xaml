<Window x:Class="WhatsApp.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhatsApp" Width="440" Height="600" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgHeader}" FontFamily="Segoe UI">
    <Grid Margin="40">
        <StackPanel x:Name="Step1" VerticalAlignment="Center">
            <TextBlock Text="Bienvenue sur WhatsApp" FontSize="26" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center"/>
            <TextBlock Text="Entrez votre numéro de téléphone et votre nom." TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextSub}" Margin="0,12,0,30"/>
            <TextBlock Text="Numéro de téléphone" Foreground="{DynamicResource TextSub}"/>
            <TextBox x:Name="PhoneBox" Style="{StaticResource Field}" Margin="0,6,0,16"/>
            <TextBlock Text="Votre nom" Foreground="{DynamicResource TextSub}"/>
            <TextBox x:Name="NameBox" Style="{StaticResource Field}" Margin="0,6,0,8"/>
            <TextBlock x:Name="Error1" Foreground="#F15C6D" Margin="0,4,0,0"/>
            <Button Content="Suivant" Style="{StaticResource GreenButton}" Click="Next_Click" IsDefault="True" Margin="0,24,0,0"/>
        </StackPanel>

        <StackPanel x:Name="Step2" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="Vérification" FontSize="26" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center"/>
            <TextBlock Text="Entrez le code de vérification à 6 chiffres." TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextSub}" Margin="0,12,0,30"/>
            <TextBox x:Name="CodeBox" Style="{StaticResource Field}" FontSize="22" HorizontalContentAlignment="Center" MaxLength="6"/>
            <TextBlock x:Name="Error2" Foreground="#F15C6D" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            <Button Content="Valider" Style="{StaticResource GreenButton}" Click="Verify_Click" IsDefault="True" Margin="0,24,0,0"/>
        </StackPanel>

        <TextBlock Text="Powered by nOX-00" FontSize="11" Foreground="{DynamicResource TextSub}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
    </Grid>
</Window>