<Window x:Class="WhatsApp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WhatsApp.App"
        Title="WhatsApp" Height="720" Width="1180" MinWidth="860" MinHeight="520"
        Background="{DynamicResource BgApp}" FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <Style x:Key="ChatItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="6,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="10,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#202323"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bulle de message avec "queue" sur le premier message d'une série -->
                <DataTemplate DataType="{x:Type local:MessageVM}">
            <Grid x:Name="Row" Margin="48,1,48,1" HorizontalAlignment="Left" MaxWidth="580">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                </Grid.ColumnDefinitions>
                <Path x:Name="TailL" Data="M8,0 L0,0 L8,9 Z" Fill="{DynamicResource BgIn}"
                      VerticalAlignment="Top" Visibility="Collapsed"/>
                <Border x:Name="Bubble" Grid.Column="1" Background="{DynamicResource BgIn}"
                        CornerRadius="8" Padding="10,6,8,5" MouseLeftButtonDown="Bubble_MouseDown">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Répondre" Click="Reply_Click"/>
                            <MenuItem Header="Copier" Click="Copy_Click"/>
                            <MenuItem Header="Supprimer" Click="Delete_Click"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel>
                        <Border x:Name="Quote" Visibility="Collapsed" Background="#26000000"
                                BorderBrush="#53BDEB" BorderThickness="3,0,0,0" CornerRadius="4"
                                Padding="8,4" Margin="0,0,0,5">
                            <TextBlock Text="{Binding ReplyText}" FontSize="13" MaxHeight="40"
                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Foreground="#B5BDC0"/>
                        </Border>
                        <Image Source="{Binding Picture}" MaxWidth="320" MaxHeight="320" Stretch="Uniform"
                               HorizontalAlignment="Left"/>
                        <TextBlock x:Name="Txt" Text="{Binding Text}" TextWrapping="Wrap" FontSize="14.5"
                                   Foreground="{DynamicResource TextMain}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Time}" FontSize="11" Foreground="#9AA3A6"/>
                            <TextBlock x:Name="Tick" Text="{Binding Tick}" FontSize="12" Margin="4,0,0,0"
                                       Foreground="#9AA3A6" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Path x:Name="TailR" Grid.Column="2" Data="M0,0 L8,0 L0,9 Z" Fill="{DynamicResource BgOut}"
                      VerticalAlignment="Top" Visibility="Collapsed"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Text}" Value="">
                    <Setter TargetName="Txt" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasReply}" Value="True">
                    <Setter TargetName="Quote" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                    <Setter TargetName="Row" Property="Margin" Value="48,8,48,1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMine}" Value="True">
                    <Setter TargetName="Row" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource BgOut}"/>
                    <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRead}" Value="True">
                    <Setter TargetName="Tick" Property="Foreground" Value="{DynamicResource Tick}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMine}" Value="False"/>
                        <Condition Binding="{Binding IsFirst}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TailL" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Bubble" Property="CornerRadius" Value="0,8,8,8"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMine}" Value="True"/>
                        <Condition Binding="{Binding IsFirst}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TailR" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Bubble" Property="CornerRadius" Value="8,0,8,8"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64"/>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Colonne d'icônes ===== -->
        <Border Background="{DynamicResource BgRail}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
            <Grid Margin="0,10">
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                    <RadioButton x:Name="RailChats" GroupName="Rail" Tag="chats" IsChecked="True"
                                 Style="{StaticResource RailButton}" Checked="Rail_Checked" ToolTip="Discussions">
                        <Grid>
                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Foreground="{DynamicResource TextMain}"/>
                            <Border x:Name="RailBadge" Background="{DynamicResource Accent}" CornerRadius="9" MinWidth="18"
                                    Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-12,-14,0" Visibility="Collapsed">
                                <TextBlock x:Name="RailBadgeText" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#0B141A" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton GroupName="Rail" Tag="calls" Style="{StaticResource RailButton}"
                                 Checked="Rail_Checked" ToolTip="Appels">
                        <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{DynamicResource TextMain}"/>
                    </RadioButton>
                    <RadioButton GroupName="Rail" Tag="status" Style="{StaticResource RailButton}"
                                 Checked="Rail_Checked" ToolTip="Statuts">
                        <Ellipse Width="22" Height="22" Stroke="{DynamicResource TextMain}" StrokeThickness="2"
                                 StrokeDashArray="2.2 1.2"/>
                    </RadioButton>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                    <RadioButton GroupName="Rail" Tag="settings" Style="{StaticResource RailButton}"
                                 Checked="Rail_Checked" ToolTip="Paramètres">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{DynamicResource TextMain}"/>
                    </RadioButton>
                    <Grid Width="34" Height="34" Margin="0,8,0,0" ToolTip="Mon profil">
                        <Ellipse Fill="{DynamicResource Accent}"/>
                        <TextBlock x:Name="ProfileInitial" Foreground="#0B141A" FontWeight="SemiBold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Colonne centrale ===== -->
        <Border Grid.Column="1" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid x:Name="ChatsPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="20,16,14,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Discussions" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="⋮" FontFamily="Segoe UI" FontSize="22"
                                Style="{StaticResource IconButton}" Margin="0,0,6,0" ToolTip="Menu"/>
                        <Button Grid.Column="2" Content="&#xE710;" Style="{StaticResource AccentIconButton}"
                                Click="NewChat_Click" ToolTip="Nouvelle discussion"/>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource BgInput}" CornerRadius="20" Margin="16,8,16,6" Height="40">
                        <Grid>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="14,0,0,0"
                                       Foreground="{DynamicResource TextSub}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBox x:Name="SearchBox" Style="{StaticResource Bare}" Margin="42,0,14,0"
                                     FontSize="14" TextChanged="Search_Changed"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="Rechercher ou démarrer une discussion"
                                       Foreground="{DynamicResource TextSub}" FontSize="14" Margin="42,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,6,16,8">
                        <RadioButton Content="Tous" GroupName="Filter" Tag="all" IsChecked="True"
                                     Style="{StaticResource Chip}" Checked="Filter_Checked"/>
                        <RadioButton Content="Non lus" GroupName="Filter" Tag="unread"
                                     Style="{StaticResource Chip}" Checked="Filter_Checked"/>
                    </StackPanel>

                    <ListBox x:Name="ChatList" Grid.Row="3" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource ChatItem}" SelectionChanged="ChatList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="49" Height="49">
                                        <Ellipse Fill="#5D6B73"/>
                                        <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="20"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Ellipse Width="13" Height="13" Fill="{DynamicResource Accent}" Stroke="{DynamicResource BgPanel}"
                                                 StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Visibility="{Binding Online, Converter={StaticResource B2V}}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="16.5" Foreground="{DynamicResource TextMain}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Preview}" FontSize="14" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextSub}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Time}" FontSize="12" Foreground="{DynamicResource TextSub}"
                                                   HorizontalAlignment="Right"/>
                                        <Border Background="{DynamicResource Accent}" CornerRadius="10" MinWidth="20" Padding="6,1"
                                                Margin="0,5,0,0" HorizontalAlignment="Right"
                                                Visibility="{Binding HasUnread, Converter={StaticResource B2V}}">
                                            <TextBlock Text="{Binding Unread}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#0B141A" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid x:Name="OtherPanel" Visibility="Collapsed">
                    <StackPanel Margin="24,20">
                        <TextBlock x:Name="OtherTitle" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                        <TextBlock x:Name="OtherText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSub}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== Conversation ===== -->
        <Grid Grid.Column="2">
            <Grid x:Name="ChatPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource BgHeader}" Padding="16,9" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="42" Height="42">
                                <Ellipse Fill="#5D6B73"/>
                                <TextBlock x:Name="ChatInitial" Foreground="White" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ChatName" Foreground="{DynamicResource TextMain}" FontSize="16.5"/>
                                <TextBlock x:Name="ChatStatus" Foreground="{DynamicResource TextSub}" FontSize="12.5"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="&#xE714;" Style="{StaticResource IconButton}" ToolTip="Appel vidéo (bientôt)"/>
                            <Button Content="&#xE721;" Style="{StaticResource IconButton}" ToolTip="Rechercher (bientôt)"/>
                            <Button Content="⋮" FontFamily="Segoe UI" FontSize="22" Style="{StaticResource IconButton}" ToolTip="Menu"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Background="{DynamicResource BgChat}">
                    <Rectangle Fill="{StaticResource Wallpaper}" IsHitTestVisible="False"/>
                    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MessageList" Margin="0,12"/>
                    </ScrollViewer>
                </Grid>

                                <Border x:Name="ReplyBar" Grid.Row="2" Visibility="Collapsed"
                        Background="{DynamicResource BgHeader}" Padding="16,10,16,0">
                    <Border Background="{DynamicResource BgInput}" CornerRadius="8" BorderBrush="#53BDEB"
                            BorderThickness="4,0,0,0" Padding="12,8">
                        <Grid>
                            <TextBlock x:Name="ReplyBarText" Foreground="{DynamicResource TextSub}" FontSize="13.5"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,34,0"/>
                            <Button Content="&#xE711;" Style="{StaticResource IconButton}" FontSize="12"
                                    Width="28" Height="28" HorizontalAlignment="Right" Click="CancelReply_Click"/>
                        </Grid>
                    </Border>
                </Border>

                <Border Grid.Row="3" Background="{DynamicResource BgHeader}" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="&#xE723;" Style="{StaticResource IconButton}" Click="Attach_Click"
                            ToolTip="Joindre une image ou un fichier"/>
                        <Border Grid.Column="1" Background="{DynamicResource BgInput}" CornerRadius="22" Margin="6,0" MinHeight="44">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="EmojiBtn" Content="&#xE76E;" Style="{StaticResource IconButton}" Margin="4,0,0,0"
                                        Click="Emoji_Click" ToolTip="Emojis"/>
                                <Popup x:Name="EmojiPopup" PlacementTarget="{Binding ElementName=EmojiBtn}" Placement="Top"
                                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Background="#1F2020" BorderBrush="#2A2D2E" BorderThickness="1" CornerRadius="12"
                                            Padding="8" Margin="0,0,0,8" Width="340" Height="260">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <WrapPanel x:Name="EmojiPanel"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                                <Grid Grid.Column="1" Margin="4,0,16,0" VerticalAlignment="Center">
                                    <TextBox x:Name="Input" Style="{StaticResource Bare}"
                                             TextChanged="Input_TextChanged" PreviewKeyDown="Input_PreviewKeyDown"/>
                                    <TextBlock x:Name="Placeholder" Text="Écrivez un message" FontSize="15"
                                               Foreground="{DynamicResource TextSub}" IsHitTestVisible="False"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <Grid Grid.Column="2">
                            <Button x:Name="MicBtn" Content="&#xE720;" Style="{StaticResource IconButton}" ToolTip="Message vocal (bientôt)"/>
                            <Button x:Name="SendBtn" Content="&#xE724;" Style="{StaticResource IconButton}"
                                    Foreground="{DynamicResource Accent}" Click="Send_Click" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="EmptyState" Background="{DynamicResource BgHeader}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="WhatsApp pour Windows" FontSize="30" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Envoyez et recevez des messages en direct, sans serveur." Margin="0,12,0,0"
                               Foreground="{DynamicResource TextSub}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Powered by nOX-00" Margin="0,60,0,0" FontSize="12"
                               Foreground="{DynamicResource TextSub}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>